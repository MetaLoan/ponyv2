{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "reference_image.jpg"
    }
  },
  "2": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "raw_input_video.mp4",
      "force_rate": 0,
      "force_size": "Disabled",
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 0,
      "skip_first_frames": 0,
      "select_every_nth": 1
    }
  },
  "3": {
    "class_type": "CannyEdgePreprocessor",
    "inputs": {
      "image": ["2", 0],
      "low_threshold": 100,
      "high_threshold": 200
    }
  },
  "4": {
    "class_type": "DepthAnythingV2Preprocessor",
    "inputs": {
      "image": ["2", 0]
    }
  },
  "5": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["3", 0],
      "frame_rate": 24,
      "format": "video/h264-mp4",
      "filename_prefix": "Wan2_Skeleton_Output",
      "pingpong": false,
      "loop_count": 0,
      "save_output": true
    }
  },
  "6": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["4", 0],
      "frame_rate": 24,
      "format": "video/h264-mp4",
      "filename_prefix": "Wan2_Depth_Output",
      "pingpong": false,
      "loop_count": 0,
      "save_output": true
    }
  },
  "7": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
