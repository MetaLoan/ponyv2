    }
  },
  "9": {
    "class_type": "WanVideoControlnetLoader",
    "inputs": {
      "model": "wan2.2-ti2v-5b-controlnet-canny-v1.safetensors",
      "base_precision": "bf16",
      "quantization": "disabled",
      "load_device": "main_device"
    }
  },
  "10": {
    "class_type": "WanVideoControlnetLoader",
    "inputs": {
      "model": "wan2.2-ti2v-5b-controlnet-depth-v1.safetensors",
      "base_precision": "bf16",
      "quantization": "disabled",
      "load_device": "main_device"
    }
  },
  "11": {
    "class_type": "WanVideoControlnetApply",
    "inputs": {
      "model": ["13", 0],
      "controlnet": ["9", 0],
      "control_images": ["3", 0],
      "strength": 0.8,
      "control_stride": 1,
      "control_start_percent": 0.0,
      "control_end_percent": 1.0
    }
  },
  "12": {
    "class_type": "WanVideoControlnetApply",
    "inputs": {
      "model": ["11", 0],
      "controlnet": ["10", 0],
      "control_images": ["4", 0],
      "strength": 0.6,
      "control_stride": 1,
      "control_start_percent": 0.0,
      "control_end_percent": 1.0
    }
  },
  "13": {
    "class_type": "WanVideoModelLoader",
    "inputs": {
      "model": "wan2.2-i2v-5b-fp8.safetensors",
      "base_precision": "bf16",
      "quantization": "disabled",
      "load_device": "offload_device"
    }
  },
  "14": {
    "class_type": "WanVideoTextEncodeCached",
    "inputs": {
      "model_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "precision": "bf16",
      "positive_prompt": "A beautiful girl walking...",
      "negative_prompt": "low quality, distorted, deformed",
      "quantization": "disabled",
      "use_disk_cache": false,
      "device": "gpu"
    }
  },
  "15": {
    "class_type": "CLIPVisionLoader",
    "inputs": {
      "clip_name": "clip_vision_h.safetensors"
    }
  },
  "16": {
    "class_type": "WanVideoClipVisionEncode",
    "inputs": {
      "strength_1": 1.0,
      "strength_2": 1.0,
      "crop": "center",
      "combine_embeds": "average",
      "force_offload": true,
      "tiles": 0,
      "ratio": 0.5,
      "clip_vision": ["15", 0],
      "image_1": ["1", 0]
    }
  },
  "19": {
    "class_type": "WanVideoVAELoader",
    "inputs": {
      "model_name": "wan_2.1_vae.safetensors",
      "precision": "bf16",
      "use_cpu_cache": false,
      "verbose": false
    }
  },
  "20": {
    "class_type": "WanVideoImageToVideoEncode",
    "inputs": {
      "width": 832,
      "height": 832,
      "num_frames": 49,
      "noise_aug_strength": 0.0,
      "start_latent_strength": 1.0,
      "end_latent_strength": 1.0,
      "force_offload": true,
      "vae": ["19", 0],
      "clip_embeds": ["16", 0],
      "start_image": ["1", 0]
    }
  },
  "21": {
    "class_type": "WanVideoSampler",
    "inputs": {
      "steps": 30,
      "cfg": 5.0,
      "shift": 5.0,
      "seed": 12345678,
      "force_offload": true,
      "scheduler": "dpm++_sde",
      "riflex_freq_index": 0,
      "denoise_strength": 1.0,
      "batched_cfg": "",
      "rope_function": "comfy",
      "start_step": 0,
      "end_step": -1,
      "add_noise_to_samples": false,
      "model": ["12", 0],
      "image_embeds": ["20", 0],
      "text_embeds": ["14", 0]
    }
  },
  "22": {
    "class_type": "WanVideoDecode",
    "inputs": {
      "samples": ["21", 0],
      "vae": ["19", 0]
    }
  },
  "23": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["22", 0],
      "frame_rate": 24,
      "format": "video/h264-mp4",
      "filename_prefix": "Wan2_Final_Result",
      "pingpong": false,
      "loop_count": 0,
      "save_output": true
    }
  }
}
